<?xml version="1.0" encoding="utf-8"?>
<!--
  The source web.config. It did not exist before: the SDK generated one from
  scratch at publish time, so there was no versioned place to set environment
  variables. Publishing does not replace this file: the SDK updates
  processPath / arguments / hostingModel on the <aspNetCore> element and leaves
  everything else alone.
  -->
<configuration>
	<system.webServer>
		<handlers>
			<add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
		</handlers>
		<aspNetCore processPath="dotnet" arguments=".\PayGramTgSrv.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
			<!--
			  PAYGRAM_INSTANCE_ID identifies the process in the Instance column of
			  dbo.Logs (Program.cs -> GlobalContext.Properties["instance"] ->
			  %property{instance} in the log4net*.config files). It replaces the old
			  "1:" prefix that was hardcoded into the @logger conversionPattern.

			  If it is not set the fallback is Environment.MachineName.

			  This file is versioned and ships identical to every server, so the value
			  below is shared by every deployment of this artifact. Once a second host
			  enters the picture, override it from the IIS Application Pool environment
			  variables, which take precedence, rather than editing this file.

			  The value is read once at startup: after changing it the application pool
			  has to be restarted.
			-->
			<environmentVariables>
				<environmentVariable name="PAYGRAM_INSTANCE_ID" value="tpg-1" />
			</environmentVariables>
		</aspNetCore>
	</system.webServer>
</configuration>
